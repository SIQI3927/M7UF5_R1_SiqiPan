      m_Calls: []
  m_text: "\n\n\nThis Message Board displays all messages sent by you and any other
    room participants using the in-game Spatial Keyboard, which is displayed once
    the Input Field UI element is selected.\n\nWhen sent, messages display the name
    of the participant wrote it and a timestamp to indicate when it was sent. \n\nAll
    messages will persist in the Message Board until the host disconnects from this
